# Copy to .env locally; do not commit actual credentials.
CALLGUARD_API_KEY=replace-with-random-at-least-32-characters
CALLGUARD_DB_PASSWORD=replace-with-random-local-password
CALLGUARD_REDIS_URL=redis://127.0.0.1:56379/0
CALLGUARD_POSTGRES_DSN=postgresql://callguard:replace-with-random-local-password@127.0.0.1:55432/callguard

# WP-08 model factory; restart server after changing provider/model.
CALLGUARD_AI_ENABLED=false
CALLGUARD_AI_PROVIDER=deepseek
CALLGUARD_AI_TIMEOUT_SECONDS=20
DEEPSEEK_API_KEY=replace-with-server-only-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional provider=openai_compatible; never reuse a provider key for a different host.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_MODEL=
